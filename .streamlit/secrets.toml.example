# Bu dosya ÖRNEKTİR — gerçek anahtarınızı buraya YAZMAYIN ve bu dosyayı
# Git'e commit etmeyin (zaten .gitignore'da secrets.toml hariç tutulmuştur).
#
# Yerelde test etmek için: bu dosyayı ".streamlit/secrets.toml" olarak kopyalayıp
# gerçek anahtarınızı girin.
#
# Streamlit Community Cloud'da: uygulamanızın "Settings" > "Secrets" sekmesine
# gidip aşağıdaki satırı gerçek anahtarınızla birlikte yapıştırın.
#
# Anahtar tanımlı DEĞİLSE uygulama hata vermez — "🤖 Yapay Zeka ile Hızlı Özet"
# butonu otomatik olarak kural tabanlı (şablon) bir özete döner.

ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
